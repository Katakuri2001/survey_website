{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.toml --env development",
    "deploy": "wrangler deploy --config ../../wrangler.toml --env production",
    "d1:execute": "wrangler d1 execute survey-db --config ../../wrangler.toml --env development --local",
    "d1:migrate": "wrangler d1 migrations create survey-db --config ../../wrangler.toml --env development",
    "d1:push": "wrangler d1 execute survey-db --config ../../wrangler.toml --env development --local --file",
    "d1:apply": "wrangler d1 migrations apply survey-db --config ../../wrangler.toml --env development --local",
    "d1:apply:production": "wrangler d1 migrations apply survey-db --config ../../wrangler.toml --env production --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@oslojs/jwt": "^0.3.0",
    "bcrypt-ts": "^5.0.3",
    "drizzle-orm": "^0.45.2",
    "h3": "^2.0.1-rc.31",
    "hono": "^4.13.7",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "wrangler": "^3.55.0"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
