# ---------------------------------------------------------------------------
# Copy to `.env` or an app's `.env.local` (never commit either) for local
# development. NEXT_PUBLIC_* values are read at build time by Next.js.
# ---------------------------------------------------------------------------

# Frontend -> API base URL for local development.
#  - Local API worker:  http://localhost:8787
#  - Same-origin Pages: /api
#  - Separate API host: https://myanmarbeer.boom.com.mm/api
NEXT_PUBLIC_API_BASE=http://localhost:8787

# `npm run build` is production-safe: the prebuild guard sets the child
# process value to /api when it sees a localhost value, and the artifact check
# fails if localhost still reaches out/. Use BUILD_TARGET=local only for an
# intentionally local static preview.

# ---------------------------------------------------------------------------
# Worker / Pages Function runtime (set via Wrangler, not this file):
#   JWT_SECRET         REQUIRED in production (>=16 chars, random)
#
# The Worker release target is explicit:
#   ENVIRONMENT=production (wrangler.toml [env.production])
#   ALLOWED_ORIGINS / PUBLIC_SITE_ORIGIN / DB_DEBUG (wrangler.toml)
#
# Pages projects use named secrets instead:
#   npx wrangler pages secret put JWT_SECRET --project-name alcohol-survey
#   npx wrangler pages secret put JWT_SECRET --project-name alcohol-survey-admin
# ---------------------------------------------------------------------------
