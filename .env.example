# ---------------------------------------------------------------------------
# Copy to `.env` (never commit `.env`) for local development.
# Values are read at build time by Next.js when prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Frontend -> API base URL.
#  - Local API worker:  http://localhost:8787
#  - Same-origin Pages: /api
#  - Separate API host: https://myanmarbeer.boom.com.mm/api
NEXT_PUBLIC_API_BASE=http://localhost:8787

# ---------------------------------------------------------------------------
# Worker / Pages Function runtime (set via `wrangler secret put`, not here):
#   JWT_SECRET         REQUIRED in production (>=16 chars, random)
#   TURNSTILE_SECRET   optional; when set, guest/spin require a Turnstile token
#   TURNSTILE_SITE_KEY optional; exposed to the frontend widget
#
# Non-secret vars live in wrangler.toml:
#   ENVIRONMENT, ALLOWED_ORIGINS, PUBLIC_SITE_ORIGIN, DB_DEBUG
# ---------------------------------------------------------------------------
