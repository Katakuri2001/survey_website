{
  "name": "alcohol-survey-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "prebuild": "node scripts/production-env-guard.mjs",
    "build": "node scripts/build-production.mjs",
    "postbuild": "node scripts/check-artifacts.mjs apps/survey-web/out apps/admin-web/out",
    "build:survey": "npm run build --workspace=apps/survey-web",
    "build:admin": "npm run build --workspace=apps/admin-web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node tests/run-tests.mjs",
    "test:api": "node tests/api-tests.mjs",
    "test:hardening": "node tests/hardening.test.mjs",
    "test:live": "npm run test:api && npm run test:hardening",
    "test:load": "k6 run loadtest/k6-spin.js",
    "migrations:validate": "node scripts/validate-migrations.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "pages:build": "node scripts/build-pages-functions.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "wrangler": "wrangler",
    "wrangler:dev": "wrangler dev --config wrangler.toml --env development",
    "deploy:api": "wrangler deploy --config wrangler.toml --env production"
  },
  "devDependencies": {
    "wrangler": "^4.134.0",
    "turbo": "^2.10.13"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.17.19": true,
    "sharp@0.35.4": true,
    "sharp@0.33.5": true,
    "workerd@1.20260917.1": true,
    "workerd@1.20250718.0": true,
    "unrs-resolver@1.12.2": true
  }
}
