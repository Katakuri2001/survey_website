{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build --workspace=apps/survey-web",
  "devCommand": "npm run dev --workspace=apps/survey-web",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "outputDirectory": "apps/survey-web/out",
  "github": {
    "enabled": false
  },
  "cleanUrls": true,
  "trailingSlash": true
}
